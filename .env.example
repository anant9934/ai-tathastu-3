# Copy to .env.local and fill in. Never commit real values.

# ─── Database (Neon) ────────────────────────────────────────────────────────
# Use the pooled connection string from the Neon console (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── Auth.js ────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Needed only behind a proxy or on non-Vercel hosts; Vercel sets it automatically.
# AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# LinkedIn OIDC — https://www.linkedin.com/developers/apps
# Product: "Sign In with LinkedIn using OpenID Connect" (scopes: openid profile email)
# Redirect URI: http://localhost:3000/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Email magic link: Resend when RESEND_API_KEY is set, otherwise SMTP below.
# Resend — https://resend.com/api-keys (sender must be on a domain verified in Resend)
RESEND_API_KEY=""
AUTH_EMAIL_FROM="AI Tathastu <signin@yourdomain.com>"
# SMTP: three Gmail senders, each with its own app password
# (Google Account → Security → 2-Step Verification → App passwords). Gmail
# rewrites any From that isn't the signed-in account, so each sends as itself.
# See src/lib/email.ts. With Gmail, AUTH_EMAIL_FROM must be the hello address.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
# auth: magic links
SMTP_HELLO_USER="hello.aitathastu@gmail.com"
SMTP_HELLO_PASSWORD=""
# system: welcome, resume ready / failed
SMTP_INFO_USER="info.aitathastu@gmail.com"
SMTP_INFO_PASSWORD=""
# support: connector alerts; Reply-To for every email
SMTP_SUPPORT_USER="support.aitathastu@gmail.com"
SMTP_SUPPORT_PASSWORD=""

# ─── Cloudflare R2 (resume uploads) ─────────────────────────────────────────
# R2 → Manage API tokens → "Object Read & Write" scoped to this bucket.
# The bucket also needs a CORS rule allowing PUT from your app origin; see README.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="ai-tathastu-uploads"

# ─── Connectors ─────────────────────────────────────────────────────────────
# GitHub OAuth App (separate from sign-in): https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/connectors/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Encrypts connector tokens/keys at rest (AES-256-GCM). The worker needs the
# same value to read them. Generate with: openssl rand -base64 32
CONNECTOR_TOKEN_KEY=""
# ORCID (faculty): Public API client from https://orcid.org/developer-tools, redirect URI
# https://www.aitathastu.com/api/connectors/orcid/callback. Only the verified iD is stored.
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
# ORCID_BASE_URL="https://sandbox.orcid.org"   # testing; default https://orcid.org

# ─── Worker only (never set these on Vercel) ────────────────────────────────
# LLM provider chain (worker/provider_router.py), comma-separated key pools.
# Text: Groq → Gemini → OpenRouter. Images (scans, photos, unreadable PDFs): Gemini → OpenRouter.
GROQ_KEYS=""
GEMINI_KEYS=""
OPENROUTER_KEYS=""
# Optional model overrides, "model[:strict|json]" lists, tried in order:
# GROQ_MODELS="openai/gpt-oss-120b:strict,openai/gpt-oss-20b:strict"
# GEMINI_MODELS="gemini-3.5-flash:strict,gemini-3.5-flash-lite:strict"
# OPENROUTER_MODELS="nvidia/nemotron-3.5-super-vl:free:strict,xingchen-agi/xing4.0-29b-a4b:free:strict"
# OPENROUTER_VISION_MODELS="nvidia/nemotron-3.5-super-vl:free:strict"

# ─── Worker wake-up (web app) ───────────────────────────────────────────────
# The worker's public health URL. Free Render instances sleep when idle; the
# app pings this after queuing a job. Leave empty when the worker is always on.
WORKER_WAKE_URL="https://ai-tathastu-worker.onrender.com/health"

# ─── Admin ──────────────────────────────────────────────────────────────────
# Emails that can open /admin (comma-separated); users.is_admin also grants it.
# Defaults to 720anant@gmail.com when unset.
ADMIN_EMAILS="720anant@gmail.com"

# ─── Worker → web app (emails) ──────────────────────────────────────────────
# Render's free tier blocks outbound SMTP, so the worker asks the app to send
# its emails (POST /api/internal/notify). Same value on Vercel and Render:
# openssl rand -base64 48
INTERNAL_API_SECRET=""
# Worker only: where to send those requests (default https://www.aitathastu.com).
# APP_URL="http://localhost:3000"

# ─── Integrated apps: Collaborate, Tathastu Meet (docs/integration-guide.md) ─
# ES256 private key (JWK) that signs integration access tokens; the public half
# is served at /api/integrations/jwks. Generate: node scripts/integration-key.mjs
INTEGRATION_JWT_PRIVATE_KEY=""
# Only during a key rotation: JSON array of the retired keys' PUBLIC JWKs (no "d").
INTEGRATION_JWT_PREVIOUS_PUBLIC_KEYS=""
# Per app: token-exchange secret (required to enable it; openssl rand -base64 32),
# exact callback URLs (comma-separated; unset = any https path on the app's
# origin), and the webhook endpoint + HMAC secret for profile.updated events.
INTEGRATION_COLLABORATE_CLIENT_SECRET=""
INTEGRATION_COLLABORATE_REDIRECT_URIS="https://collaborate.aitathastu.com/api/auth/tathastu/callback"
INTEGRATION_COLLABORATE_WEBHOOK_URL="https://collaborate.aitathastu.com/api/webhooks/tathastu"
INTEGRATION_COLLABORATE_WEBHOOK_SECRET=""
INTEGRATION_MEET_CLIENT_SECRET=""
INTEGRATION_MEET_REDIRECT_URIS=""
INTEGRATION_MEET_WEBHOOK_URL=""
INTEGRATION_MEET_WEBHOOK_SECRET=""
# Vercel Cron authenticates to /api/internal/webhooks/dispatch with this (daily retry sweep).
CRON_SECRET=""

# ─── Pilot-site embed (Phase 4) ─────────────────────────────────────────────
# Signs the 15-minute embed tokens. Must differ from AUTH_SECRET: openssl rand -base64 48
EMBED_JWT_SECRET=""
# Sites allowed to show the widget (exact origins, comma-separated), e.g. https://pilot.example.edu
EMBED_ALLOWED_ORIGINS=""
